{
  "name": "lithicanalyst",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source 3D annotation platform for lithic artefacts: flake scar direction vectors on 3D meshes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/make-artifact.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "tsc --noEmit -p e2e && npm run build && playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.1",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
